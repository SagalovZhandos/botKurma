# ===== Обязательно =====
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=

# ID группы (узнать: добавить бота в группу и написать /chatid). Несколько — через запятую.
CHAT_IDS=

# ===== AI-чат (бесплатно) =====
# Бесплатный ключ Groq: https://console.groq.com/keys
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
# Любой OpenAI-совместимый API, по умолчанию Groq:
# AI_URL=https://api.groq.com/openai/v1/chat/completions

# Как часто бот сам вступает в разговор: off | quiet | normal | active (в чате меняется командой /mode)
AMBIENT_MODE=normal

# ===== Картинки (бесплатно) =====
# Бесплатный ключ sk_... с https://enter.pollinations.ai (вход через GitHub).
# Нужен для картинок; заодно служит запасным AI, если Groq недоступен.
POLLINATIONS_TOKEN=

# ===== Расписание и оформление =====
TZ_NAME=Asia/Almaty
MORNING_TIME=08:00
# {day} — Дүйсенбі, {day_ru} — Понедельник, {date} — 30.10. Например: "Достар | {day}"
TITLE_TEMPLATE={day}
# Удалять служебное «бот изменил название группы»
DELETE_TITLE_SERVICE_MSG=true
# За сколько дней напоминать о дне рождения (0 — не напоминать)
BIRTHDAY_REMIND_DAYS=3
# Города: Название:широта:долгота через «;»
CITIES=Алматы:43.2389:76.8897;Астана:51.1694:71.4491;Актобе:50.2839:57.1670

# ===== Доступ =====
# Ваш Telegram ID (через /chatid в личке с ботом). Если пусто — /settitle может вызвать любой участник.
ADMIN_IDS=

# ===== Хостинг =====
# Задаётся хостингом автоматически (Render/Koyeb). Включает /health-ответ для пингера.
# PORT=8080
